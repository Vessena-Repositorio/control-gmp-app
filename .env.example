# Conexion a Postgres (Coolify la expone como variable del servicio)
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Puerto del servidor HTTP
PORT=3000

# Endpoint de Apps Script del que se replican los datos de envases
ORIGEN_ENVASES=https://script.google.com/macros/s/AKfycby0Idz2-18NsukOhRqqrQrgHCpO7f4gX67kb-5gH0xA1DLxw7t39Yr37_PakYth5srj/exec

# Token para disparar el sync por HTTP (POST /api/sync). Generar uno largo y aleatorio.
SYNC_TOKEN=

# Minutos entre sincronizaciones automaticas. 0 desactiva el sync periodico.
SYNC_INTERVALO_MIN=15

# Permite que una migracion con sentencias destructivas (DROP TABLE/COLUMN,
# TRUNCATE, DELETE FROM, ALTER COLUMN ... TYPE) se aplique sola en el deploy.
# Dejar SIN configurar salvo que sea intencional y haya backup: el historico de
# un sistema GMP no se recupera solo.
MIGRACIONES_DESTRUCTIVAS=

# Endpoint de Apps Script del dominio de control en proceso (index.html)
# Desde el 17/09/2026 la planilla esta cerrada y la replica no la usa (034).
ORIGEN_PROCESO=https://script.google.com/macros/s/AKfycbxmayMAPlLCrozmZRM3gLSf5MgcWO9lC5y_ayR0DkRdi_hHYaoLRI43OgIJ9d7nTPDGug/exec

# Endpoint de Apps Script de SAO-001 (validacion del sistema de agua). Devuelve CSV.
ORIGEN_SAO001=https://script.google.com/macros/s/AKfycbxxrGTAQPYbrMtcxHQjV_JlcursrBkvuQmnD9xV3zTF7JZ8Emy0cx29ITBCK7nNzRe7tw/exec

# Hoja de Google (gviz CSV) con los KPIs de Fabuloso. No pasa por Apps Script.
ORIGEN_FABULOSO=https://docs.google.com/spreadsheets/d/1j5TkRMZbnR8v7vhPGGKiwJ3HnPErKFtM44BOyG02gk4/export?format=csv&gid=0

# --- Dominios que se migran a Postgres pero cuyas apps siguen usando su hoja ---
# Apps Script de la app vieja de No Conformidades y de Control de Cambios. Desde el
# 16/09/2026 no lo usa ninguna app ni ninguna replica. Solo lo lee "Traer datos
# finales" de Control de Cambios (POST /api/control-cambios/resembrar), que ya se
# uso en el corte. Se puede quitar al archivar el script.
ORIGEN_NC=https://script.google.com/macros/s/AKfycbwiIr60f7GWLPrRV0cVhLFp7Hm3Igc8qKEL1sWZiAd6vgDFD8XyP0Yu29fxof03ipdE/exec
ORIGEN_ESTABILIDAD=https://script.google.com/macros/s/AKfycby3255SdR4jZ2ia6td9ShJGyJmuz7pKwKg6QN_zov5k8uR88ubnD9AkHsBwIIH9qZCZ/exec
ORIGEN_CAPACITACIONES=https://script.google.com/macros/s/AKfycbztHgoYblBahz1DEw2MeHkx2cplCDfFCGCnTJz8Rt1Opwt64v4x7Mayt3eML0i1pqJF/exec
ORIGEN_DEVOLUCIONES=https://script.google.com/macros/s/AKfycbwRDBhiXtbW_EdIUdoTWQiIj7Yb8pYi9eTQtLEuT_Gcafmerg-N0YGtBAJIAenwOVKt/exec

# --- Correo saliente (reemplaza al MailApp de Apps Script) ---
# La clave NO va aca: se carga como variable de entorno en Coolify y nunca
# se commitea. Este repositorio es publico.
SMTP_HOST=email8.pl.com.uy
SMTP_PUERTO=587
SMTP_REMITENTE=notificacionesQA@vessena.com.uy
SMTP_NOMBRE=Calidad Vessena
# SMTP_USUARIO=   (opcional; si falta se usa SMTP_REMITENTE)
# SMTP_CLAVE=     (solo en Coolify)

# --- Avisos de vencimiento de acciones CAPA ---
# Un resumen semanal (los lunes) por persona, mas una copia a Calidad.
# Acepta varias direcciones separadas por coma.
CORREO_CALIDAD=
AVISOS_CAPA_ACTIVOS=0
AVISOS_CAPA_HORA=8
AVISOS_CAPA_DIAS_PREVIOS=7
# Dia del resumen: lunes..domingo o 1..7; "diario" = todos los dias.
AVISOS_CAPA_DIA=lunes
ZONA_HORARIA=America/Montevideo

# --- Avisos migrados desde Apps Script (arrancan apagados) ---
# Los botones de los correos apuntan aca; si queda en GitHub Pages, se rompen.
URL_PUBLICA=http://192.168.30.15:3000
AVISOS_ESTABILIDAD_ACTIVOS=0
AVISOS_ESTABILIDAD_HORA=8
AVISOS_CAPACITACIONES_ACTIVOS=0
AVISOS_CAPACITACIONES_HORA=8

# Tareas de Control de Cambios (tabla de responsables de cada cambio) por vencer
# o vencidas: un resumen semanal (los lunes) a cada responsable y copia a supervision
# (notificacion_supervisores 'control-cambios' / 'tareas-vencidas').
# Dejar en 0 hasta el corte: antes, la tabla es una copia que se queda vieja.
AVISOS_CONTROL_CAMBIOS_ACTIVOS=0
AVISOS_CONTROL_CAMBIOS_HORA=8
AVISOS_CONTROL_CAMBIOS_DIAS_PREVIOS=7
AVISOS_CONTROL_CAMBIOS_DIA=lunes

# --- Aviso semanal de analisis pendientes de aprobacion (envases) ---
AVISOS_ENVASES_ACTIVOS=0
AVISOS_ENVASES_HORA=8

# --- Avisos de muestras de granel sin aprobar ---
# Diario (lunes a viernes) a quien aprueba, y resumen de los lunes a Calidad.
AVISOS_GRANELES_ACTIVOS=0
AVISOS_GRANELES_HORA=8
AVISOS_FABULOSO_ACTIVOS=0
AVISOS_FABULOSO_HORA=10

# --- Ordenes de envasado sin aprobar (control en proceso) ---
# Todos los dias a las 8, a quienes aprueban (notificacion_supervisores
# 'control-en-proceso' / 'pendientes-aprobacion').
AVISOS_PROCESO_ACTIVOS=0
AVISOS_PROCESO_HORA=8

# --- Lectura de planillas de capacitacion con IA (Gemini de Google) ---
# Reemplaza al OCR y la carga masiva que hacia el Apps Script de capacitaciones.
# La clave NO va aca: se carga como variable de entorno en Coolify y nunca se
# commitea. Se saca en https://aistudio.google.com/apikey
# GEMINI_API_KEY=   (solo en Coolify)
GEMINI_MODELO=gemini-3.6-flash
# GEMINI_MODELO_RESPALDO=   (opcional: segundo modelo si el principal esta saturado)
# Tope de espera por lectura, en milisegundos (4 minutos).
GEMINI_ESPERA_MS=240000
