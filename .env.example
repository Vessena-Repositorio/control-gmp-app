# Conexion a Postgres (Coolify la expone como variable del servicio)
DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# Puerto del servidor HTTP
PORT=3000

# Endpoint de Apps Script del que se replican los datos de envases
ORIGEN_ENVASES=https://script.google.com/macros/s/AKfycby0Idz2-18NsukOhRqqrQrgHCpO7f4gX67kb-5gH0xA1DLxw7t39Yr37_PakYth5srj/exec

# Token para disparar el sync por HTTP (POST /api/sync). Generar uno largo y aleatorio.
SYNC_TOKEN=

# Minutos entre sincronizaciones automaticas. 0 desactiva el sync periodico.
SYNC_INTERVALO_MIN=15

# Permite que una migracion con sentencias destructivas (DROP TABLE/COLUMN,
# TRUNCATE, DELETE FROM, ALTER COLUMN ... TYPE) se aplique sola en el deploy.
# Dejar SIN configurar salvo que sea intencional y haya backup: el historico de
# un sistema GMP no se recupera solo.
MIGRACIONES_DESTRUCTIVAS=

# Endpoint de Apps Script del dominio de control en proceso (index.html)
ORIGEN_PROCESO=https://script.google.com/macros/s/AKfycbxmayMAPlLCrozmZRM3gLSf5MgcWO9lC5y_ayR0DkRdi_hHYaoLRI43OgIJ9d7nTPDGug/exec

# Endpoint de Apps Script de SAO-001 (validacion del sistema de agua). Devuelve CSV.
ORIGEN_SAO001=https://script.google.com/macros/s/AKfycbxxrGTAQPYbrMtcxHQjV_JlcursrBkvuQmnD9xV3zTF7JZ8Emy0cx29ITBCK7nNzRe7tw/exec

# Hoja de Google (gviz CSV) con los KPIs de Fabuloso. No pasa por Apps Script.
ORIGEN_FABULOSO=https://docs.google.com/spreadsheets/d/1j5TkRMZbnR8v7vhPGGKiwJ3HnPErKFtM44BOyG02gk4/gviz/tq?tqx=out:csv&gid=0&headers=1

# --- Dominios que se migran a Postgres pero cuyas apps siguen usando su hoja ---
# No conformidades y control de cambios comparten el mismo Apps Script.
ORIGEN_NC=https://script.google.com/macros/s/AKfycbwiIr60f7GWLPrRV0cVhLFp7Hm3Igc8qKEL1sWZiAd6vgDFD8XyP0Yu29fxof03ipdE/exec
ORIGEN_ESTABILIDAD=https://script.google.com/macros/s/AKfycby3255SdR4jZ2ia6td9ShJGyJmuz7pKwKg6QN_zov5k8uR88ubnD9AkHsBwIIH9qZCZ/exec
ORIGEN_CAPACITACIONES=https://script.google.com/macros/s/AKfycbztHgoYblBahz1DEw2MeHkx2cplCDfFCGCnTJz8Rt1Opwt64v4x7Mayt3eML0i1pqJF/exec
ORIGEN_DEVOLUCIONES=https://script.google.com/macros/s/AKfycbwRDBhiXtbW_EdIUdoTWQiIj7Yb8pYi9eTQtLEuT_Gcafmerg-N0YGtBAJIAenwOVKt/exec
